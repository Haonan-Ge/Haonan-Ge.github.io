<div class="photo-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <img class="photo-lightbox-img" src="" alt="">
  <button type="button" class="photo-lightbox-nav photo-lightbox-prev" aria-label="Previous photo">&#8249;</button>
  <button type="button" class="photo-lightbox-nav photo-lightbox-next" aria-label="Next photo">&#8250;</button>
  <button type="button" class="photo-lightbox-close" aria-label="Close">&times;</button>
</div>

<script>
  (function () {
    const stream = document.querySelector(".photo-stream");
    if (!stream) return;

    // Duplicate each row once so the drift loops seamlessly; copies are hidden from assistive tech.
    stream.querySelectorAll(".photo-track").forEach((track) => {
      Array.from(track.children).forEach((tile) => {
        const copy = tile.cloneNode(true);
        copy.setAttribute("aria-hidden", "true");
        copy.tabIndex = -1;
        copy.querySelector("img").alt = "";
        track.appendChild(copy);
      });
    });

    // Lightbox over the original photos
    const photos = Array.from(stream.querySelectorAll(".photo-tile:not([aria-hidden]) img"));
    const box = document.querySelector(".photo-lightbox");
    const big = box.querySelector(".photo-lightbox-img");
    let current = 0;
    let opener = null;

    function show(i) {
      current = (i + photos.length) % photos.length;
      big.src = photos[current].src;
      big.alt = photos[current].alt;
    }
    function open(i, from) {
      opener = from;
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
      box.querySelector(".photo-lightbox-close").focus();
    }
    function close() {
      box.hidden = true;
      document.body.style.overflow = "";
      if (opener) opener.focus();
    }

    stream.addEventListener("click", (e) => {
      const tile = e.target.closest(".photo-tile");
      if (!tile) return;
      const src = tile.querySelector("img").getAttribute("src");
      open(photos.findIndex((p) => p.getAttribute("src") === src), tile);
    });
    box.querySelector(".photo-lightbox-close").addEventListener("click", close);
    box.querySelector(".photo-lightbox-prev").addEventListener("click", () => show(current - 1));
    box.querySelector(".photo-lightbox-next").addEventListener("click", () => show(current + 1));
    box.addEventListener("click", (e) => {
      if (e.target === box) close();
    });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    let touchX = null;
    box.addEventListener("touchstart", (e) => (touchX = e.touches[0].clientX), { passive: true });
    box.addEventListener("touchend", (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      touchX = null;
    });
  })();
</script>
