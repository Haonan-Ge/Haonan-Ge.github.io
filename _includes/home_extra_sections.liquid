  <div class="misc-gallery-frame" aria-label="Photography gallery">
    <div class="misc-gallery misc-gallery--smart">
      <figure class="misc-tile"><img src="/assets/img/1.jpg" alt="Photo 1" loading="lazy"></figure>
      <figure class="misc-tile"><img src="/assets/img/2.jpg" alt="Photo 2" loading="lazy"></figure>
      <figure class="misc-tile"><img src="/assets/img/3.jpg" alt="Photo 3" loading="lazy"></figure>
      <figure class="misc-tile"><img src="/assets/img/4.jpg" alt="Photo 4" loading="lazy"></figure>
