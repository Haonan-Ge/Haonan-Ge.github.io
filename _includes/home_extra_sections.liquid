<script>
  document.addEventListener("DOMContentLoaded", function () {
    const gallery = document.querySelector(".misc-gallery--smart");
    if (!gallery) return;

    const tiles = Array.from(gallery.querySelectorAll(".misc-tile"));
    const gapVar = () => parseFloat(getComputedStyle(gallery).getPropertyValue("--misc-gap")) || 6;
    let rafId = null;

    const getTargetRowHeight = () => {
      if (window.innerWidth < 576) return 120;
      if (window.innerWidth < 992) return 132;
      return 150;
    };

    const finalizeRow = (galleryWidth, row, rowAspectSum, isLastRow) => {
      if (!row.length) return null;

      const gap = gapVar();
      const availableWidth = galleryWidth - gap * Math.max(0, row.length - 1);
      const justifiedHeight = availableWidth / rowAspectSum;
      const targetHeight = getTargetRowHeight();
      const rowHeight = isLastRow ? Math.min(targetHeight, justifiedHeight) : justifiedHeight;

      const rowElement = document.createElement("div");
      rowElement.className = "misc-row";
      rowElement.style.height = `${rowHeight}px`;

      row.forEach((tile) => {
        const ratio = parseFloat(tile.dataset.ratio || "1");
        tile.style.width = `${rowHeight * ratio}px`;
        tile.style.height = `${rowHeight}px`;
        rowElement.appendChild(tile);
      });

      return rowElement;
    };

    const renderGallery = () => {
      const galleryWidth = gallery.clientWidth;
      if (!galleryWidth) return;

      const readyTiles = tiles.filter((tile) => {
        const image = tile.querySelector("img");
        return image && image.naturalWidth && image.naturalHeight;
      });

      if (!readyTiles.length) return;

      gallery.innerHTML = "";

      const rowTargetWidth = galleryWidth * 0.98;
      let row = [];
      let rowAspectSum = 0;

      readyTiles.forEach((tile, index) => {
        const ratio = parseFloat(tile.dataset.ratio || "1");
        row.push(tile);
        rowAspectSum += ratio;

        const estimatedWidth = rowAspectSum * getTargetRowHeight() + gapVar() * Math.max(0, row.length - 1);
        const shouldFlush = estimatedWidth >= rowTargetWidth;
        const isLastTile = index === readyTiles.length - 1;

        if (shouldFlush || isLastTile) {
          const rowElement = finalizeRow(galleryWidth, row, rowAspectSum, isLastTile && !shouldFlush);
          if (rowElement) gallery.appendChild(rowElement);
          row = [];
          rowAspectSum = 0;
        }
      });
    };

    const scheduleRender = () => {
      window.cancelAnimationFrame(rafId);
      rafId = window.requestAnimationFrame(renderGallery);
    };

    tiles.forEach((tile) => {
      const image = tile.querySelector("img");
      if (!image) return;

      const measure = () => {
        if (image.naturalWidth && image.naturalHeight) {
          tile.dataset.ratio = (image.naturalWidth / image.naturalHeight).toString();
          scheduleRender();
        }
      };

      if (image.complete) {
        measure();
      } else {
        image.addEventListener("load", measure, { once: true });
      }
    });

    window.addEventListener("resize", scheduleRender);
  });
</script>


